rules_version = '2';
// قواعد أمان Firestore: كل مستخدم يقرأ ويكتب بياناته فقط.
// انشرها من Firebase Console > Firestore Database > Rules، أو عبر: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // سعر الصرف المعروض في صفحة المتجر: يقرؤه الجميع، ويكتبه صاحب الحساب الذي أنشأه فقط
    match /public/store {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.rate is number && request.resource.data.rate > 0 && request.resource.data.rate < 100;
      allow update: if request.auth != null
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.rate is number && request.resource.data.rate > 0 && request.resource.data.rate < 100;
    }
    // عداد زوار صفحة المتجر وطلباتها: مستند لكل يوم، الزائر يزيد رقماً واحداً بمقدار 1 فقط، وصاحب المتجر وحده يقرأ
    match /stats/{day} {
      allow read: if request.auth != null
        && request.auth.uid == get(/databases/$(database)/documents/public/store).data.owner;
      allow create: if day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['visits', 'orders'])
        && request.resource.data.size() == 1
        && request.resource.data.get('visits', 1) == 1
        && request.resource.data.get('orders', 1) == 1;
      allow update: if request.resource.data.keys().hasOnly(['visits', 'orders'])
        && ((request.resource.data.get('visits', 0) == resource.data.get('visits', 0) + 1
             && request.resource.data.get('orders', 0) == resource.data.get('orders', 0))
         || (request.resource.data.get('orders', 0) == resource.data.get('orders', 0) + 1
             && request.resource.data.get('visits', 0) == resource.data.get('visits', 0)));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
