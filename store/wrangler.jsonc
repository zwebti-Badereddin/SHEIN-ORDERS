// صفحة المتجر على Cloudflare Workers: ملفات ثابتة + /api/cart لقراءة سلة SHEIN
{
  "name": "sheinstore-ly",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
